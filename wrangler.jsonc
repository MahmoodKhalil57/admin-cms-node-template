{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin-cms-node-template",
  "compatibility_date": "2025-07-13",
  "compatibility_flags": ["nodejs_compat"],

  // LOCAL DEVELOPMENT ONLY.
  //
  // In production nothing reads this file: master supplies each node's bindings
  // in the Workers-for-Platforms upload metadata, so one built artifact serves
  // every node. These entries exist so `vite dev` gets miniflare-emulated
  // D1/R2/KV (wrangler's getPlatformProxy reads this config), persisted under
  // .wrangler/state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "admin-cms-node-dev",
      "database_id": "local"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "admin-cms-node-dev-media" }],
  "kv_namespaces": [{ "binding": "KV", "id": "local" }],
  "vars": {
    "NODE_ID": "dev",
    "NODE_NAME": "Dev Node",
    "FEATURES": "forms",
    "PROVISION_TOKEN": "dev-only"
  }
}
